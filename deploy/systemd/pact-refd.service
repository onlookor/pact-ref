[Unit]
Description=PACT reference plane (pact-refd)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pactref
Group=pactref
Environment=PACT_REF_BIND=127.0.0.1:8090
Environment=PACT_REF_AUTH_MODE=deny
Environment=PACT_REF_AUDIT=off
ExecStart=/usr/local/bin/refd
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pact-ref

[Install]
WantedBy=multi-user.target
